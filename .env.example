# PredictIQ Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to version control.

VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_"import_secrets;print(secrets.token_urlsafe(64))"
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=predictiq
POSTGRES_PASSWORD=predictiq_secret
POSTGRES_DB=predictiq

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

MODEL_DEVICE=auto
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=predictiq-development

ALERT_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#maintenance-alerts

ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
LOG_FORMAT=text

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=PredictIQ

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
KAFKA_UI_PASSWORD=admin
